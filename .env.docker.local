# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://raguser:ragpassword@db:5432/ragdb
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpassword
POSTGRES_DB=ragdb

# ─── Security ─────────────────────────────────────────────────────────────────
APP_SECRET_KEY=change-me-to-a-random-32-char-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Ollama (ollama service inside docker-compose) ────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434
LLM_MODEL=gemma3:4b
EMBEDDING_MODEL=nomic-embed-text

# ─── LiveKit ──────────────────────────────────────────────────────────────────
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-change-me-in-production-use-32chars

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://frontend:3000","https://ngrok.io","https://*.ngrok-free.app","https://*.ngrok.io"]

# ─── File uploads ─────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50

# ─── Vector store ─────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=data/chroma
