# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://raguser:ragpassword@db:5432/ragdb
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpassword
POSTGRES_DB=ragdb

# ─── Security ─────────────────────────────────────────────────────────────────
APP_SECRET_KEY=change-me-to-a-random-32-char-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Ollama ───────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434
LLM_MODEL=gemma3:4b
EMBEDDING_MODEL=nomic-embed-text
# nomic-embed-text asymmetric prefixes are configured in src/config.py defaults.
# Override here only if using a different model that doesn't need prefixes.

# ─── Neo4j (Knowledge Graph) ─────────────────────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jpassword

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://frontend:3000","https://ngrok.io","https://*.ngrok-free.app","https://*.ngrok.io"]

# ─── File uploads ─────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50

# ─── Redis cache ─────────────────────────────────────────────────────────────
REDIS_CACHE_URL=redis://redis:6379/1

# ─── Vector store ─────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=data/chroma
VECTOR_STORE_TYPE=qdrant
QDRANT_URL=http://qdrant:6333

# ─── Advanced RAG — all features enabled ─────────────────────────────────────
SEMANTIC_CACHE_ENABLED=true
EMBEDDING_CACHE_ENABLED=true
QUERY_CLASSIFIER_ENABLED=true
CONVERSATION_MEMORY_ENABLED=true
PARALLEL_PIPELINE_ENABLED=true
HYBRID_SEARCH_ENABLED=true
QUERY_REWRITING_ENABLED=false
QUERY_REWRITE_MODE=multi
QUERY_REWRITE_COUNT=3
CONTEXTUAL_RETRIEVAL_ENABLED=true
AUTO_TAGGING_ENABLED=true
KNOWLEDGE_GRAPH_ENABLED=true

# ─── Re-ranking (local flashrank — no API key needed) ────────────────────────
RERANKER_TYPE=local
RERANKER_TOP_N=8
RETRIEVAL_TOP_K=20
RETRIEVAL_SCORE_THRESHOLD=0.0

# ─── Chunking ─────────────────────────────────────────────────────────────────
DEFAULT_CHUNKING_STRATEGY=hierarchical
HIERARCHICAL_PARENT_SIZE=800
HIERARCHICAL_CHILD_SIZE=300

# ─── MinIO object storage ─────────────────────────────────────────────────────
# Set STORAGE_BACKEND=minio to use MinIO instead of local filesystem
STORAGE_BACKEND=local
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=nexus-documents
MINIO_SECURE=false

# ─── RabbitMQ async job queue ─────────────────────────────────────────────────
# Set RABBITMQ_ENABLED=true to route ingestion/embedding jobs through RabbitMQ
RABBITMQ_ENABLED=false
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# ─── Prometheus metrics ───────────────────────────────────────────────────────
# Metrics exposed at http://backend:8000/metrics — scraped by Prometheus
# Grafana UI: http://localhost:3001  (admin / admin)
ENABLE_METRICS=true

# ─── LDAP / Active Directory ──────────────────────────────────────────────────
# Set LDAP_ENABLED=true and fill in your AD details to enable LDAP login
LDAP_ENABLED=false
LDAP_SERVER=ldap://ldap:389
LDAP_BIND_DN=cn=svc,dc=example,dc=com
LDAP_BIND_PASSWORD=secret
LDAP_BASE_DN=dc=example,dc=com
LDAP_USER_FILTER=(sAMAccountName={username})
LDAP_GROUP_ROLE_MAP={}
LDAP_TLS=false
