APP_ENV=development
APP_SECRET_KEY=dev-secret-change-me-in-production-min-32-chars

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/rag.db

# Vector Store
VECTOR_STORE_TYPE=chroma
CHROMA_PERSIST_DIR=./data/chroma

# Embedding
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# LLM
LLM_PROVIDER=ollama
LLM_MODEL=gemma3:4b
OLLAMA_BASE_URL=http://localhost:11434

# Auth
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Ingestion
MAX_UPLOAD_SIZE_MB=100
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MIN_CHUNK_SIZE=50
MAX_CHUNK_SIZE=1024

# Search
HYBRID_SEARCH_ENABLED=true
QUERY_REWRITING_ENABLED=true

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ── LiveKit ──────────────────────────────────────────────────────────────────
# Windows / Linux → LiveKit runs in Docker (UDP works natively):
#                     docker compose up
#
# macOS dev only  → Docker Desktop breaks WebRTC UDP; run LiveKit natively:
#                     brew install livekit
#                     livekit-server --config livekit.yaml
#                   Everything else stays in Docker as normal.
#
# HOST_IP — set to this machine's LAN/public IP so browsers on other devices
# can reach the LiveKit WebRTC server (ICE node_ip).
# Windows:  ipconfig  → IPv4 Address of your active network adapter
# Linux:    hostname -I | awk '{print $1}'
# Leave blank if only accessing from this machine (localhost only).
HOST_IP=
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-change-me-in-production-use-32chars

# ── TURN server (optional, self-hosted only) ──────────────────────────────────
# Only needed if participants are behind a restrictive corporate firewall/NAT.
# Must be self-hosted — no third-party services.
# Self-hosted coturn on a Linux server:
#   sudo apt install coturn   # then configure /etc/turnserver.conf
#   TURN_URL=turn:<your-linux-server-ip>:3478?transport=tcp
#   ICE_TRANSPORT_POLICY=relay
# Leave blank for normal local development.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
ICE_TRANSPORT_POLICY=all

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jpassword

# LlamaIndex — semantic chunking + property graph ingestion
LLAMAINDEX_PIPELINE_ENABLED=true
LLAMAINDEX_GRAPH_ENABLED=true

# Compliance
COMPLIANCE_LLM_ENABLED=false
COMPLIANCE_LLM_MODEL=gemma3:4b
COMPLIANCE_LLM_TIMEOUT=30
COMPLIANCE_LLM_MAX_TEXT_LENGTH=4000
