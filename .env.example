APP_ENV=development
APP_SECRET_KEY=dev-secret-change-me-in-production-min-32-chars
APP_URL=http://localhost:3000

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/rag.db
# For PostgreSQL (already in docker-compose):
# DATABASE_URL=postgresql+asyncpg://raguser:ragpassword@localhost:5432/ragdb

# Vector Store
VECTOR_STORE_TYPE=chroma
CHROMA_PERSIST_DIR=./data/chroma

# Embedding
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# LLM
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
# Optional cloud LLM providers (leave blank if using Ollama)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Auth
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Registration — set to true to require an invite token to register
INVITE_ONLY=false

# Ingestion
MAX_UPLOAD_SIZE_MB=100
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MIN_CHUNK_SIZE=50
MAX_CHUNK_SIZE=1024

# Search
HYBRID_SEARCH_ENABLED=true
QUERY_REWRITING_ENABLED=false

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ─── Email / SMTP ──────────────────────────────────────────────────────────────
# Leave SMTP_HOST blank in dev — emails will be logged but not sent.
# Works with any SMTP provider: Gmail, Zoho, Mailgun, SendGrid SMTP, AWS SES SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=Nexus <your@gmail.com>
SMTP_TLS=true
# For SendGrid: SMTP_HOST=smtp.sendgrid.net, SMTP_PORT=587, SMTP_USER=apikey, SMTP_PASSWORD=<SendGrid API key>
# For Mailgun:  SMTP_HOST=smtp.mailgun.org, SMTP_PORT=587

# ─── OAuth / SSO ───────────────────────────────────────────────────────────────
# Google OAuth — create at https://console.cloud.google.com → APIs & Services → Credentials
# Redirect URI to add: http://localhost:8000/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth — create at https://portal.azure.com → App registrations
# Redirect URI to add: http://localhost:8000/api/v1/auth/oauth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Frontend: enable SSO buttons on the login page (set to "true" when credentials are filled in)
NEXT_PUBLIC_GOOGLE_SSO_ENABLED=false
NEXT_PUBLIC_MICROSOFT_SSO_ENABLED=false

# ─── Redis / Celery ────────────────────────────────────────────────────────────
# Leave blank to run ingestion in-process (dev mode, no Redis required).
# Set to redis://localhost:6379/0 when Redis is running.
REDIS_URL=

# ─── Observability ─────────────────────────────────────────────────────────────
# Set to "true" to expose /metrics (Prometheus scrape endpoint).
ENABLE_METRICS=false
LOG_LEVEL=INFO
# LOG_FORMAT=json   # set to "json" for structured logs (default in Docker), "text" for local dev

# ─── Livekit — self-hosted video (open source, Apache 2.0) ────────────────────
# Server config: livekit.yaml  |  Docker: see docker-compose.yml
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-change-me-in-production-use-32chars

# ─── Compliance ────────────────────────────────────────────────────────────────
COMPLIANCE_LLM_ENABLED=false
COMPLIANCE_LLM_MODEL=llama3.1:8b
COMPLIANCE_LLM_TIMEOUT=30
COMPLIANCE_LLM_MAX_TEXT_LENGTH=4000
